# The public site keeps using Contentlayer until the database import is verified.
CONTENT_SOURCE=contentlayer

# PostgreSQL (local value matches compose.yaml).
DATABASE_URL=postgresql://nerukigat:nerukigat-local@127.0.0.1:5432/nerukigat
DATABASE_POOL_MAX=10

# Single-owner authentication. Generate a high-entropy secret with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Magren
AUTH_ALLOW_SIGNUP=false
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Used only by `pnpm auth:create-owner`; remove it after bootstrapping.
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-temporary-strong-password

# Server-side S3-compatible object storage (Cloudflare R2 in production).
# Never rename these variables with a NEXT_PUBLIC_ prefix.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-a-bucket-scoped-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-bucket-scoped-secret

# These must be separate buckets. The private bucket stores original uploads
# before EXIF removal and must not have a public domain or anonymous policy.
S3_PUBLIC_BUCKET=nerukigat-public
S3_PRIVATE_BUCKET=nerukigat-private
S3_PUBLIC_BASE_URL=https://img.example.com

# R2 uses false. MinIO generally needs true.
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=uploads
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=20971520
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif

# Local MinIO example overrides:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=nerukigat
# S3_SECRET_ACCESS_KEY=nerukigat-local-secret
# S3_PUBLIC_BUCKET=nerukigat-public
# S3_PRIVATE_BUCKET=nerukigat-private
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/nerukigat-public
